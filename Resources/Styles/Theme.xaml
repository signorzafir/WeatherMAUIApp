<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             >
    <!--Custom Code-->

    <!-- Colors -->
    <Color x:Key="BgTop">#0B1020</Color>
    <Color x:Key="BgBottom">#142B5C</Color>
    <Color x:Key="CardBg">#1A2440</Color>
    <Color x:Key="Accent">#4DA3FF</Color>
    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#C9D4FF</Color>
    <Color x:Key="ErrorColor">#FF6B6B</Color>

    <!-- Gradients -->
    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource BgTop}" Offset="0"/>
        <GradientStop Color="{StaticResource BgBottom}" Offset="1"/>
    </LinearGradientBrush>



    <!-- Text -->


    <Style x:Key="TitleLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="SubtleLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Cards -->
    <Style x:Key="CardFrame" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource CardBg}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="HasShadow" Value="True" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <!-- Keyed styles (safe, no conflicts) -->
    <Style x:Key="PageBackground" TargetType="ContentPage">
        <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
    </Style>


    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="PrimaryLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style x:Key="IconPrimary" TargetType="Image">
        <Setter Property="WidthRequest" Value="70" />
        <Setter Property="HeightRequest" Value="70"/>
    </Style>

    <Style x:Key="IconSecondary" TargetType="Image">
        <Setter Property="WidthRequest" Value="25" />
        <Setter Property="HeightRequest" Value="25"/>
    </Style>



</ResourceDictionary>