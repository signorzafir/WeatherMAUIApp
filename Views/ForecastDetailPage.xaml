<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WeatherMAUIApp.Views.ForecastDetailPage"
             Title="Details">

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="14">

            <!-- Header -->
            <VerticalStackLayout Spacing="2">
                <Label Text="{Binding CityName}"
                       FontSize="20"
                       FontAttributes="Bold" />

                <Label Text="{Binding DateText}"
                       FontSize="14"
                       Opacity="0.75" />
            </VerticalStackLayout>

            <!-- Main Card -->
            <Frame 
                   CornerRadius="18"
                   Padding="16"
                   HasShadow="True"
                   BackgroundColor="#1A2440">

                <VerticalStackLayout Spacing="12">

                    <!-- Icon + Condition -->
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <Label Text="{Binding Day.WeatherIcon}" FontSize="50" />
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Day.WeatherText}" FontSize="40" />
                            <Label Text="Forecast details"
                                   FontSize="15"
                                   Opacity="0.75" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <!-- Big Temp -->
                    <Label Text="{Binding BigTempText}"
                           FontSize="65"
                           FontAttributes="Bold"
                           HorizontalOptions="Start" />

                    <Label Text="{Binding MinMaxText}"
                           FontSize="14"
                           Opacity="0.8" />

                    <!-- Divider -->
                    <BoxView HeightRequest="1" Opacity="0.25" />

                    <!-- Detail grid -->
                    <Grid ColumnDefinitions="*,*" 
                          RowDefinitions="Auto,Auto,auto" 
                          ColumnSpacing="14" 
                          RowSpacing="10">

                        <Frame Grid.Row="0" Grid.Column="0"
                               CornerRadius="14"
                               Padding="12"
                               HasShadow="False"
                               BackgroundColor="#22305A">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="🌡️" FontSize="30" />
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="Min / Max" FontSize="12" Opacity="0.75"/>
                                    <Label Text="{Binding TempText}" FontSize="16" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Frame>

                        <!-- Wind -->
                        <Frame Grid.Row="0" Grid.Column="1"
                               CornerRadius="14"
                               Padding="12"
                               HasShadow="False"
                               BackgroundColor="#22305A">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="💨" FontSize="30" />
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="Wind" FontSize="12" Opacity="0.75"/>
                                    <Label Text="{Binding WindText}" FontSize="16" FontAttributes="Bold"/>

                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Frame>
                        <!--Precipitation-->
                        <Frame Grid.Row="1" 
                               Grid.Column="0"
                               
                               CornerRadius="14"
                               Padding="12"
                               HasShadow="False"
                               BackgroundColor="#22305A">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="☔" FontSize="30" />
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="Precipitation" FontSize="12" Opacity="0.75"/>
                                    <!--<Label Text="(add later)" FontSize="16" FontAttributes="Bold"/>-->
                                    <Label Text="{Binding PrecipText}" FontSize="16" FontAttributes="Bold"/>

                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Frame>
                        
                        <!--Humidity-->
                        <Frame Grid.Row="1" Grid.Column="1" 
                               CornerRadius="14" 
                               Padding="12" HasShadow="False" 
                               BackgroundColor="#22305A">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="💧" FontSize="30" />
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="Humidity" FontSize="12" Opacity="0.75"/>
                                    <Label Text="{Binding HumidityText}" FontSize="16" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Frame>

                        <!--Sunrise/Sunset-->
                        <Frame Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                               CornerRadius="14" Padding="12" 
                               HasShadow="False" 
                               BackgroundColor="#22305A">
                            <VerticalStackLayout Spacing="6">
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="🌅" FontSize="30"/>
                                    <Label Text="{Binding SunriseText}" FontAttributes="Bold"/>
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="🌇" FontSize="30"/>
                                    <Label Text="{Binding SunsetText}" FontAttributes="Bold"/>
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="⏱️" FontSize="30"/>
                                    <Label Text="{Binding DayDurationText}" FontAttributes="Bold"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Frame>



                    </Grid>

                </VerticalStackLayout>
            </Frame>

            <!-- Back hint -->
            <Label Text="Tip: use the back button to return to the forecast list."
                   FontSize="12"
                   Opacity="0.7" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
