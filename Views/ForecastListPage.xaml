<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WeatherMAUIApp.Views.ForecastListPage"
             Title="Forecast"
             BackgroundColor="#0B1020">

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="14">

            <!-- Header -->
            <VerticalStackLayout Spacing="2">
                <Label Text="7-Day Forecast"
                       TextColor="White"
                       FontSize="22"
                       FontAttributes="Bold" />
                <Label Text="Choose a city and tap a day for details"
                       TextColor="#C9D4FF"
                       FontSize="13" />
            </VerticalStackLayout>

            <!-- City Picker Card -->
            <Frame BackgroundColor="#1A2440"
                   CornerRadius="16"
                   Padding="14"
                   HasShadow="True">

                <VerticalStackLayout Spacing="10">
                    <Label Text="📍 City"
                           TextColor="White"
                           FontAttributes="Bold"
                           FontSize="14" />

                    <Picker ItemsSource="{Binding Cities}"
                            ItemDisplayBinding="{Binding DisplayName}"
                            SelectedItem="{Binding SelectedCity}"
                            Title="Select city"
                            TextColor="White"
                            TitleColor="#C9D4FF"
                            BackgroundColor="Transparent" />
                </VerticalStackLayout>
            </Frame>

            <!-- Loading + Error -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="#4DA3FF" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="#FF6B6B"
                   IsVisible="{Binding HasError}" />

            <!-- Forecast List -->
            <CollectionView ItemsSource="{Binding Items}"
                            SelectionMode="Single"
                            SelectionChanged="OnSelectionChanged">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Frame BackgroundColor="#1A2440"
                               CornerRadius="16"
                               Padding="14"
                               Margin="0,6"
                               HasShadow="True">

                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="12"
                                  VerticalOptions="Center">

                                <!-- Icon -->
                                <!--<Label Text="📅"
                                       FontSize="18"
                                       TextColor="White"
                                       Grid.Column="0" />-->
                                <!--<Label Text="{Binding WeatherIcon}" FontSize="22" TextColor="White" />-->
                                <Image Source="{Binding WeatherIcon}" WidthRequest="64" HeightRequest="64" />


                                <!-- Date + Temp -->
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding DateText}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="White" />
                                    
                                    <Label Text="{Binding TempText}"
                                           FontSize="13"
                                           TextColor="#C9D4FF" />
                                    <Label Text="{Binding WeatherText}"
                                           FontSize="12"
                                           TextColor="#C9D4FF" />
                                </VerticalStackLayout>

                                <!-- Chevron -->
                                <Label Text="›"
                                       FontSize="24"
                                       TextColor="#C9D4FF"
                                       Grid.Column="2"
                                       VerticalTextAlignment="Center" />

                            </Grid>

                        </Frame>

                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Actions -->
            <Button Text="Refresh"
                    Command="{Binding RefreshCommand}"
                    BackgroundColor="#4DA3FF"
                    TextColor="White"
                    CornerRadius="14"
                    Padding="14,12"
                    FontAttributes="Bold" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

