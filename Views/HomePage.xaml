<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WeatherMAUIApp.ViewModels"
             x:Class="WeatherMAUIApp.Views.HomePage"
             Title="Home"
             Style="{StaticResource PageBackground}">

    <ContentPage.BindingContext>
        <vm:HomeViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="14">

            <!-- Header -->
            <VerticalStackLayout Spacing="2">
                <Label Text="{Binding Today.CityName}" Style="{StaticResource TitleLabel}" />
                <Label Text="Today overview" Style="{StaticResource SubtleLabel}" />
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="{StaticResource ErrorColor}"
                   IsVisible="{Binding HasError}" />

            <!-- Main card -->
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="12">

                    <HorizontalStackLayout Spacing="12">
                        <VerticalStackLayout>
                            <Label Text="Now" Style="{StaticResource SubtleLabel}" />

                            <Image Source="{Binding Today.WeatherIcon}" WidthRequest="64" HeightRequest="64" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Today.CurrentTempText}"
                                   FontSize="35"
                                   FontAttributes="Bold"
                                   Style="{StaticResource PrimaryLabel}"
                                   />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <BoxView HeightRequest="1" Opacity="0.25" />

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="12">

                        <Frame Grid.Row="0" Grid.Column="0"
                               CornerRadius="14"
                               Padding="12"
                               HasShadow="False"
                               BackgroundColor="#22305A">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="🥶" FontSize="18" Style="{StaticResource PrimaryLabel}" />
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="Feels like" Style="{StaticResource SubtleLabel}" />
                                    <Label Text="{Binding Today.CurrentFeelsLikeText}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           Style="{StaticResource PrimaryLabel}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Frame>

                        <Frame Grid.Row="0" Grid.Column="1"
                               CornerRadius="14"
                               Padding="12"
                               HasShadow="False"
                               BackgroundColor="#22305A">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="💧" FontSize="18" Style="{StaticResource PrimaryLabel}" />
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="Humidity" Style="{StaticResource SubtleLabel}" />
                                    <Label Text="{Binding Today.CurrentHumidity}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           Style="{StaticResource PrimaryLabel}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Frame>

                        <Frame Grid.Row="1" Grid.ColumnSpan="2"
                               CornerRadius="14"
                               Padding="12"
                               HasShadow="False"
                               BackgroundColor="#22305A">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="📈" FontSize="18" Style="{StaticResource PrimaryLabel}" />
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="Max / Min" Style="{StaticResource SubtleLabel}" />
                                    <Label Text="{Binding Today.TodayMaxMinText}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           Style="{StaticResource PrimaryLabel}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Frame>

                    </Grid>

                </VerticalStackLayout>
            </Frame>

            <!-- Sun card -->
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Sun" FontAttributes="Bold" FontSize="16" Style="{StaticResource PrimaryLabel}" />

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">

                        <Frame Grid.Column="0" CornerRadius="14" Padding="12" HasShadow="False" BackgroundColor="#22305A">
                            <VerticalStackLayout Spacing="2">
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="🌅" FontSize="18" Style="{StaticResource PrimaryLabel}" />
                                    <Label Text="Sunrise" Style="{StaticResource SubtleLabel}" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding Today.TodaySunriseText}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       Style="{StaticResource PrimaryLabel}" />
                            </VerticalStackLayout>
                        </Frame>

                        <Frame Grid.Column="1" CornerRadius="14" Padding="12" HasShadow="False" BackgroundColor="#22305A">
                            <VerticalStackLayout Spacing="2">
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="🌇" FontSize="18" Style="{StaticResource PrimaryLabel}" />
                                    <Label Text="Sunset" Style="{StaticResource SubtleLabel}" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding Today.TodaySunsetText}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       Style="{StaticResource PrimaryLabel}" />
                            </VerticalStackLayout>
                        </Frame>

                        <Frame Grid.Column="2" CornerRadius="14" Padding="12" HasShadow="False" BackgroundColor="#22305A">
                            <VerticalStackLayout Spacing="2">
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="⏱️" FontSize="18" Style="{StaticResource PrimaryLabel}" />
                                    <Label Text="Day length" Style="{StaticResource SubtleLabel}" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding Today.TodayDayDurationText}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       Style="{StaticResource PrimaryLabel}" />
                            </VerticalStackLayout>
                        </Frame>

                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <Button Text="Go to 7-day forecast"
                    Style="{StaticResource PrimaryButton}"
                    Clicked="OnForecastClicked" />

            <Button Text="Reload"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding LoadCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

